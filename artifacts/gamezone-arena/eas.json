{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "internal": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_PRODUCTION": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_PRODUCTION": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}