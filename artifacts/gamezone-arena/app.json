{
  "expo": {
    "name": "GAMEZONE ARENA",
    "slug": "gamezone-arena",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gamezone-arena",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A13"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.gamezonearena.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#070A13"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Camera permission is required to take a photo.",
          "photosPermission": "Allow GAMEZONE ARENA to choose photos."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5348301935438016~5109940531",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      "./plugins/withAndroidPackagingOptions"
    ],
    "extra": {
      "eas": {
        "projectId": "4e9dc944-2a7b-4051-95be-b276401e6e06"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "gajpalgamezones-team"
  }
}
